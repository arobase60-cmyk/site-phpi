---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "PHPI - Documentation technique" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>

</head>

<body>

<header class="site-header">

    <div class="logo">
        <a href={base}>PHPI</a>
    </div>

    <nav class="main-nav">

       <a href={base}>Accueil</a>

<a href={`${base}/historique`}>Historique</a>

<a href={`${base}/architecture`}>Architecture</a>

<a href={`${base}/essais`}>Essais</a>

<a href={`${base}/galerie`}>Galerie</a>

<a href={`${base}/contact`}>Contact</a>

    </nav>

</header>

<main>

    <slot />

</main>

<footer>

    <p><strong>PHPI</strong></p>

    <p>Documentation technique du Poste Hydraulique à Pupitre Individuel</p>

    <p>Projet de sauvegarde patrimoniale</p>

</footer>

</body>

</html>