---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const cartes = await getCollection("architecture");
cartes.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Architecture du PHPI">

  <div class="page-header">
    <h1>Architecture du PHPI</h1>

    <p>
      Cette section présente l'architecture générale du PHPI,
      ses différents éléments et leur organisation.
    </p>
  </div>

  <div class="cards">

    {
      cartes.map((carte) => (

        <article class="card">

          <a href={`${base}architecture/${carte.id}/`}>

            {
              carte.data.hero && (
                <img
                  src={`${base}${carte.data.hero}`}
                  alt={carte.data.title}
                  class="card-image"
                />
              )
            }

            <div class="card-content">

              <h2>{carte.data.title}</h2>

              {
                carte.data.description && (
                  <p>{carte.data.description}</p>
                )
              }

              <span class="card-link">
                Lire la suite →
              </span>

            </div>

          </a>

        </article>

      ))
    }

  </div>

</Layout>

<style>

.page-header {
  max-width: 900px;
  margin: 0 auto 3rem;
}

.page-header h1 {
  color: #0b5ea8;
  font-size: 2.5rem;
  margin-bottom: 1rem;
}

.page-header p {
  font-size: 1.1rem;
  line-height: 1.7;
}

.cards {
  max-width: 1000px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: repeat(
    auto-fit,
    minmax(280px, 1fr)
  );

  gap: 2rem;
}

.card {
  background: white;
  border-radius: 10px;
  overflow: hidden;

  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);

  transition:
    transform 0.25s,
    box-shadow 0.25s;
}

.card:hover {
  transform: translateY(-4px);

  box-shadow:
    0 8px 18px rgba(0, 0, 0, 0.18);
}

.card a {
  display: block;

  color: inherit;
  text-decoration: none;
}

.card-image {
  display: block;

  width: 100%;
  height: 200px;

  object-fit: cover;
}

.card-content {
  padding: 1.5rem;
}

.card-content h2 {
  margin: 0 0 0.8rem;

  color: #0b5ea8;

  font-size: 1.4rem;
}

.card-content p {
  margin: 0 0 1rem;

  line-height: 1.6;
}

.card-link {
  display: inline-block;

  color: #0b5ea8;

  font-weight: bold;
}

</style>