---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";

export async function getStaticPaths() {
  const cartes = await getCollection("architecture");

  return cartes.map((carte) => ({
    params: { slug: carte.id },
    props: { carte },
  }));
}

const { carte } = Astro.props;

const { Content } = await render(carte);

const cartes = await getCollection("architecture");

cartes.sort((a, b) => a.data.order - b.data.order);

const index = cartes.findIndex((c) => c.id === carte.id);

const precedent = index > 0 ? cartes[index - 1] : null;
const suivant = index < cartes.length - 1 ? cartes[index + 1] : null;

const imageUrl = carte.data.hero
  ? base + carte.data.hero.replace(/^\/+/, "")
  : base + "images/photo-a-venir.png";
---

<Layout title={carte.data.title}>

  <p>
    <a href={base + "architecture/"}>
      ← Retour à l'architecture
    </a>
  </p>

  <h1>{carte.data.title}</h1>

  <img
    src={imageUrl}
    alt={carte.data.title}
    class="fiche-image"
  />

  <div class="fiche">
    <Content />
  </div>

  <nav class="fiche-nav">

    {
      precedent ? (
        <a href={base + "architecture/" + precedent.id + "/"}>
          ← Précédent
        </a>
      ) : (
        <span></span>
      )
    }

    {
      suivant ? (
        <a href={base + "architecture/" + suivant.id + "/" }>
          Suivant →
        </a>
      ) : (
        <span></span>
      )
    }

  </nav>

</Layout>