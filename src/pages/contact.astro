---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">

<section class="contact">

    <h1>Contact</h1>

    <p>
        Ce site a été réalisé afin de conserver et transmettre la mémoire technique
        du <strong>Poste Hybride à Procédés Informatiques (PHPI)</strong>.
    </p>

    <p>
        Si vous possédez des documents, photographies ou informations concernant le
        PHPI ou les relais NS1, vous pouvez prendre contact.
    </p>

    <div class="contact-box">

        <h2>Coordonnées</h2>

        <p>
            <strong>Auteur :</strong> Martial Hervet
        </p>

        <p>
            <strong>Email :</strong><br>
            <a href="mailto:phpi.cris@gmail.com">
               phpi.cris@gmail.com
            </a>
        </p>

    </div>

</section>

<style>
.contact{
    max-width:900px;
    margin:auto;
    padding:2rem;
}

.contact h1{
    color:#0b5ea8;
    margin-bottom:1.5rem;
}

.contact p{
    font-size:1.1rem;
    line-height:1.7;
}

.contact-box{
    margin-top:2rem;
    padding:2rem;
    background:#f5f7fa;
    border-left:5px solid #0b5ea8;
    border-radius:8px;
}

.contact-box a{
    color:#0b5ea8;
    text-decoration:none;
    font-weight:600;
}

.contact-box a:hover{
    text-decoration:underline;
}
</style>

</Layout>