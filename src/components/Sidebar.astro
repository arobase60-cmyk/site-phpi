---
interface Props {
  articles: any[];
  titre: string;
  baseUrl: string;
  actif?: string;
}

const { articles, titre, baseUrl, actif } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<aside class="sidebar">

    <h3>{titre}</h3>

    <ul>

        {
            articles.map((article) => (

                <li>

                    <a
                        href={base + baseUrl + "/" + article.id}
                        class={article.id === actif ? "active" : ""}
                    >

                        {article.data.title}

                    </a>

                </li>

            ))
        }

    </ul>

</aside>